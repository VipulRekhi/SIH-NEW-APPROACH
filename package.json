{
  "name": "nawi-r76-system",
  "version": "1.0.0",
  "description": "NAWI Test Report Generation System as per OIML Recommendation R-76 (SIH 2026 PS-26035)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "migrate": "npm run migrate --prefix server",
    "seed:admin": "npm run seed:admin --prefix server",
    "test:server": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
